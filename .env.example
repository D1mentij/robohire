# AI provider: "ollama" (default, local, free, offline) or "gemini" (optional, needs a key)
AI_PROVIDER=ollama

# --- Ollama (local) ---
# ollama pull qwen3-vl:8b-instruct   (default, 6.2 GB)   |   ollama pull qwen3-vl:4b-instruct   (smaller fallback, 3.3 GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_FALLBACK_MODEL=qwen3-vl:4b-instruct
# max video frames sent to the model (small local models are slow with many images)
OLLAMA_MAX_FRAMES=4

# --- Gemini (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=
# optional, comma-separated; default: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
