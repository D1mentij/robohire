# AI provider: "ollama" (default, local, free, offline) or "gemini" (optional, needs a key)
AI_PROVIDER=ollama

# --- Ollama (local) ---
# Default: qwen3-vl:4b-instruct (3.3 GB) — measured valid 9/9 runs, ~15 s warm / ~33 s cold on a MacBook Air M5; less RAM for a backup laptop.
# ollama pull qwen3-vl:4b-instruct   |   optional better labels but slower (~24 s warm): ollama pull qwen3-vl:8b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_FALLBACK_MODEL=qwen3-vl:8b-instruct
# frames sent to the model; the browser extracts 4 @ 512 px (measured fastest setting that finds the zones)
# model stays in RAM between calls (warm-up at server start)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_FRAMES=4

# --- Gemini (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=
# optional, comma-separated; default: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
